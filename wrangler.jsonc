{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog",
			"database_id": "5fef057c-f46d-44f6-9c70-005e06e9b5db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "blog",
		},
	],
	// Astro Cloudflare session driver binding. The adapter injects SESSION without
	// an id when absent here, which fails Workers Builds deploys (error 10021).
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "c25b328c8eb641608331d9f5e52e62d7",
		},
	],
	// Preview deployments (wrangler preview / Workers Builds) read bindings only
	// from this section; the adapter injects SESSION here without an id otherwise,
	// which the preview deployments API rejects (error 10021).
	"previews": {
		"kv_namespaces": [
			{
				"binding": "SESSION",
				"id": "c25b328c8eb641608331d9f5e52e62d7",
			},
		],
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger (scheduled publishing etc.)
	// Free plan: keep this infrequent -- each cron run pays full bundle CPU
	// on cold isolates, and the 10ms free CPU limit trips easily. Runs hourly.
	"triggers": {
		"crons": ["0 * * * *"],
	},
}
