---
/**
 * Home -- port of theme/layouts/home.vue.
 * Hero image, haiku quote, featured posts grid, RSS subscribe section.
 */
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { resolveImageUrl, resolveImageAlt } from "../utils/media";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const HERO_IMAGE = "/_emdash/api/media/file/home-page-1.jpg";

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 6,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title={siteTitle} description={siteTagline}>
	<div class="tach-portfolio">
		{
			HERO_IMAGE && (
				<section class="tach-portfolio-hero">
					<img class="hero-img" src={HERO_IMAGE} alt={siteTitle} />
				</section>
			)
		}

		<section class="tach-portfolio-haiku">
			<div class="haiku-content">
				<small>There will</small>
				<h4>
					still be <span>love</span> in this world
				</h4>
			</div>
		</section>

		{
			posts.length > 0 && (
				<section class="tach-portfolio-feature">
					<h4 class="feature-title">Featured</h4>
					<div class="feature-grid">
						{posts.map((post) => {
							const img = resolveImageUrl(post.data.featured_image);
							return (
								<article class="tach-portfolio-item">
									<figure class="item-content">
										<a class="link" href={`/posts/${post.id}`}>
											<div class="pic-box">
												{img && (
													<img
														class="item-cover"
														src={img}
														alt={resolveImageAlt(post.data.featured_image) || post.data.title}
														loading="lazy"
													/>
												)}
												<span class="overlay">{post.data.title}</span>
											</div>
										</a>
									</figure>
								</article>
							);
						})}
					</div>
				</section>
			)
		}

		<section class="tach-portfolio-subscribe">
			<div class="subscribe-content">
				<h4>Feeds</h4>
				<p>如果你不想错过更新的文章，可以通过 RSS 订阅本博客</p>
				<a class="button" target="_blank" rel="noopener" href="/rss.xml">
					Subscribe
				</a>
			</div>
		</section>
	</div>
</Base>

<style>
	.tach-portfolio-hero .hero-img {
		display: block;
		width: 100%;
		height: 80vw;
		max-height: 80vh;
		object-fit: cover;
	}

	.tach-portfolio-haiku {
		padding-top: 4rem;
	}

	.haiku-content {
		padding: 0 var(--gap-m);
		text-align: center;
	}

	.haiku-content small {
		display: block;
		margin-bottom: var(--gap-m);
		color: var(--color-text-secondary);
		letter-spacing: 4px;
		text-transform: uppercase;
	}

	.haiku-content h4 {
		letter-spacing: 6px;
		font-weight: 400;
		line-height: var(--leading-relaxed);
		text-transform: uppercase;
		font-size: var(--font-size-lg);
	}

	.haiku-content h4 span {
		background: #2f2f2f;
		color: #ffffff;
		padding: 0.3rem;
		padding-right: 0;
	}

	.tach-portfolio-feature {
		padding-top: 2.7778rem;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding-left: var(--gap-m);
		padding-right: var(--gap-m);
	}

	.feature-title {
		margin: 0 0 var(--gap-l);
		text-align: center;
		line-height: var(--leading-relaxed);
		letter-spacing: 2px;
		text-transform: uppercase;
		font-size: var(--font-size-base);
		font-weight: 500;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--gap-m);
	}

	.tach-portfolio-item .item-content {
		position: relative;
		margin: 0;
	}

	.pic-box {
		position: relative;
		overflow: hidden;
		z-index: 1;
		aspect-ratio: 4 / 3;
		background: var(--color-surface);
	}

	.item-cover {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
		transition: transform 0.5s ease-in-out;
	}

	.overlay {
		display: flex;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: var(--gap-l);
		color: #ffffff;
		position: absolute;
		width: 100%;
		height: 100%;
		top: 0;
		left: 0;
		background: rgba(47, 47, 47, 0.5);
		opacity: 0;
		z-index: 1;
		transition: opacity 0.3s ease-in-out;
	}

	.tach-portfolio-item:hover .overlay {
		opacity: 1;
	}

	.tach-portfolio-item:hover .item-cover {
		transform: scale(1.05);
	}

	.tach-portfolio-subscribe {
		padding: 3rem 0;
		text-align: center;
	}

	.subscribe-content {
		padding: 0 var(--gap-m);
	}

	.subscribe-content h4 {
		text-align: center;
		letter-spacing: 2px;
		line-height: var(--leading-relaxed);
		text-transform: uppercase;
		font-size: var(--font-size-base);
		font-weight: 500;
		margin-bottom: var(--gap-m);
	}

	.subscribe-content p {
		color: var(--color-text-primary);
		margin-bottom: 0;
	}

	a.button {
		display: inline-block;
		height: auto;
		background: #2f2f2f;
		color: #ffffff;
		margin-top: 1.7778rem;
		border-radius: 50px;
		padding: 0.6rem 3.2rem;
		border: 1px solid var(--color-accent-6);
		transition: all 0.2s ease-in-out;
		text-decoration: none;
	}

	a.button:hover {
		background: #ffffff;
		color: #2f2f2f;
		text-decoration: none;
	}

	@media (max-width: 900px) {
		.feature-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.feature-grid {
			grid-template-columns: 1fr;
		}

		/* Always show titles on touch devices (original theme behaviour) */
		.overlay {
			opacity: 1;
		}
	}
</style>
