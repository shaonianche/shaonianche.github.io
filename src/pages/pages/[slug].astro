---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="page-content" role="main">
		<div class="page-inner-wrapper">
			<header class="page-header">
				<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
			</header>

			<section class="page-body entry" {...page.edit.content}>
				<PortableText value={page.data.content} />
			</section>

			<footer class="page-footer"></footer>
		</div>
	</article>
</Base>

<style>
	.page-content {
		padding-top: 2rem;
		width: 100%;
	}

	.page-inner-wrapper {
		margin: 0 auto;
		max-width: 840px;
		padding: 0 var(--gap-m);
	}

	.page-title {
		margin: 0 0 var(--gap-l);
		font-size: 2rem;
		line-height: 1.2;
	}

	/* shared body typography with post detail */
	.page-body :global(p),
	.page-body :global(blockquote),
	.page-body :global(ul),
	.page-body :global(ol),
	.page-body :global(pre),
	.page-body :global(table),
	.page-body :global(figure) {
		margin-bottom: var(--gap-l);
	}

	.page-body :global(p) {
		text-align: justify;
		line-height: var(--leading-relaxed);
		overflow-wrap: break-word;
	}

	.page-body :global(a) {
		color: var(--color-link);
		text-decoration: none;
		overflow-wrap: break-word;
	}

	.page-body :global(a:hover) {
		text-decoration: underline;
	}

	.page-body :global(h2) {
		font-size: 1.5rem;
		margin-top: 2em;
		margin-bottom: 0.75em;
	}

	.page-body :global(h3) {
		font-size: 1.25rem;
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-body :global(blockquote) {
		position: relative;
		color: var(--color-text-secondary);
		padding-left: var(--gap-l);
		margin-left: 0;
	}

	.page-body :global(blockquote::before) {
		position: absolute;
		left: calc(var(--gap-m) * -1.7);
		content: "\201c";
		font-size: 2.25rem;
		font-weight: 700;
		line-height: 1;
	}

	.page-body :global(ul),
	.page-body :global(ol) {
		padding-left: calc(var(--gap-m) * 1.5);
	}

	.page-body :global(ul) {
		list-style-type: square;
	}

	.page-body :global(pre),
	.page-body :global(code) {
		font-family: var(--font-mono);
	}

	.page-body :global(pre) {
		background: var(--color-accent-1);
		padding: var(--gap-m);
		overflow: auto;
		line-height: 1.5;
	}

	.page-body :global(:not(pre) > code) {
		color: var(--color-link);
		font-size: 0.875em;
	}

	.page-body :global(:not(pre) > code::before),
	.page-body :global(:not(pre) > code::after) {
		content: "`";
	}

	.page-body :global(img) {
		max-width: 100%;
	}

	.page-body :global(p img) {
		display: block;
		margin: 0 auto;
	}

	.page-footer {
		margin-bottom: var(--gap-l);
	}
</style>
