---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="page-content" role="main">
		<div class="page-inner-wrapper">
			<header class="page-header">
				<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
			</header>

			<section class="page-body entry" {...page.edit.content}>
				<PortableText value={page.data.content} />
			</section>

			<footer class="page-footer"></footer>
		</div>
	</article>
</Base>

<style>
	.page-content {
		padding-top: 2rem;
		width: 100%;
	}

	.page-inner-wrapper {
		margin: 0 auto;
		max-width: 840px;
		padding: 0 var(--gap-m);
	}

	.page-title {
		margin: 0 0 var(--gap-l);
		font-size: 2rem;
		line-height: 1.2;
	}

	/* shared body typography lives in src/styles/prose.css */

	.page-footer {
		margin-bottom: var(--gap-l);
	}
</style>
