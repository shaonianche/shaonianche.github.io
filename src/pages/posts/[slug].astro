---
/**
 * Post detail -- port of theme/layouts/default.vue.
 * Cover, title, date, categories, outdated-post warning, tags.
 * Comments use EmDash's built-in system (already configured).
 */
import {
	getEmDashEntry,
	getEmDashCollection,
	getTermsForEntries,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import {
	resolveImageUrl,
	resolveImageAlt,
	transformImageUrl,
	transformSrcset,
} from "../../utils/media";
import {
	formatPostDate,
	formatDayDate,
	daysAgo,
} from "../../utils/format-date";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const coverUrl = resolveImageUrl(post.data.featured_image);
const coverAlt =
	resolveImageAlt(post.data.featured_image) || post.data.title;
const featuredImageUrl = coverUrl
	? coverUrl.startsWith("http")
		? coverUrl
		: `${Astro.url.origin}${coverUrl}`
	: undefined;
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl,
});

// Outdated-post warning (original: > 365 days since updatedAt/createdAt)
const postDate = post.data.updatedAt ?? post.data.publishedAt ?? null;
const days = postDate ? daysAgo(postDate) : 0;
const isOutdated = days > 365;
const humanDate = postDate ? formatDayDate(postDate) : "";
const metaDate = post.data.publishedAt ?? post.data.updatedAt ?? null;

const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];

const { entries: recentPosts, cacheHint: recentCacheHint } =
	await getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 4,
	});
if (Astro.cache?.enabled) Astro.cache.set(recentCacheHint);
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);
const otherTagsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"tag",
);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	tags: otherTagsByEntry.get(p.data.id) ?? [],
}));
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article
		class="page-content"
		role="main"
		itemscope
		itemtype="https://schema.org/Article"
	>
		<div class="page-inner-wrapper">
			<header class:list={["page-header", coverUrl && "page-has-cover"]}>
				{
					coverUrl && (
						<section class="page-cover">
							<img
								class="image"
								src={transformImageUrl(post.data.featured_image, 840)}
								srcset={transformSrcset(post.data.featured_image, [840, 1680])}
								sizes="(min-width: 900px) 840px, 100vw"
								alt={coverAlt}
								decoding="async"
								{...post.edit.featured_image}
							/>
							<span class="overlay" />
						</section>
					)
				}
				<section class="page-head-content">
					<h1 class="page-title" {...post.edit.title}>{post.data.title}</h1>
					<div class="page-meta">
						{
							metaDate && (
								<section class="page-datetime">
									<time
										class="published"
										datetime={metaDate.toISOString()}
									>
										{formatPostDate(metaDate)}
									</time>
								</section>
							)
						}
						{
							categories.length > 0 && (
								<section class="page-categories">
									{categories.map((item, index) => (
										<span>
											{index > 0 && <span>, </span>}
											<a
												class="category"
												href={`/category/${item.slug}`}
											>
												{item.label}
											</a>
										</span>
									))}
								</section>
							)
						}
					</div>
				</section>
			</header>

			{
				isOutdated && (
					<section class="page-alert outdated-alert">
						本文最后更新于 {days} 天前（{humanDate}
						），其中的信息可能已经有所发展或者不再适合现阶段。
					</section>
				)
			}

			<section class="page-body entry" {...post.edit.content}>
				<PortableText value={post.data.content} />
			</section>

			{
				tags.length > 0 && (
					<section class="page-block-action">
						<div class="page-tags">
							{tags.map((item, index) => (
								<span>
									{index > 0 && <span>, </span>}
									<a class="tag" href={`/tag/${item.slug}`}>
										{item.label}
									</a>
								</span>
							))}
						</div>
					</section>
				)
			}

			<div class="article-comments">
				<Comments collection="posts" contentId={post.data.id} threaded />
				<CommentForm collection="posts" contentId={post.data.id} />
			</div>

			<footer class="page-footer"></footer>
		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="more-posts">
				<div class="more-inner">
					<h2 class="more-title">Continue reading</h2>
					<div class="more-grid">
						{otherPostsWithTags.map(({ post: p }) => (
							<PostCard
								title={p.data.title}
								excerpt={p.data.excerpt}
								featuredImage={p.data.featured_image}
								href={`/posts/${p.id}`}
								date={p.data.publishedAt ?? undefined}
								edit={p.edit}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>

<style>
	.page-content {
		padding-top: 2rem;
		width: 100%;
	}

	.page-inner-wrapper {
		margin: 0 auto;
		max-width: 840px;
		padding: 0 var(--gap-m);
	}

	.page-header {
		position: relative;
	}

	.page-cover {
		position: relative;
		padding-top: 66.6666%; /* 3:2 */
		overflow: hidden;
		background: var(--color-surface);
	}

	.page-cover img {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.page-head-content {
		margin-top: var(--gap-m);
	}

	.page-title {
		margin: 0 0 var(--gap-s);
		font-size: 2rem;
		line-height: 1.2;
	}

	.page-has-cover .page-head-content {
		margin-top: var(--gap-l);
	}

	.page-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		font-size: 0.75rem;
		color: var(--color-text-secondary);
	}

	.page-categories {
		display: flex;
		align-items: center;
	}

	.page-categories::before {
		content: "・";
	}

	.page-categories .category {
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.page-categories .category:hover {
		color: var(--color-link);
	}

	.page-alert {
		margin: var(--gap-l) 0 0 0;
		padding: var(--gap-m);
		background-color: var(--color-accent-1);
		font-size: 0.75rem;
		border-radius: 0;
		color: var(--color-text-primary);
	}

	/* ---------- body typography lives in src/styles/prose.css ---------- */
	.page-body {
		margin-top: var(--gap-l);
	}

	.page-block-action {
		margin-top: var(--gap-l);
		display: flex;
		justify-content: flex-end;
	}

	.page-tags {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
	}

	.page-tags .tag {
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.page-tags .tag::before {
		content: "#";
		opacity: 0.5;
		margin-right: 0.1rem;
	}

	.page-tags .tag:hover {
		color: var(--color-link);
		opacity: 1;
	}

	.page-footer {
		margin-bottom: var(--gap-l);
	}

	/* comments */
	.article-comments {
		margin-top: var(--gap-xl);
		padding-top: var(--gap-l);
		border-top: 1px solid var(--color-border-subtle);
	}

	/* continue reading */
	.more-posts {
		background: var(--color-bg-subtle);
		padding: var(--gap-xl) 0;
		margin-top: var(--gap-xl);
	}

	.more-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--gap-m);
	}

	.more-title {
		font-size: 1.5rem;
		margin-bottom: var(--gap-l);
	}

	.more-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--gap-m);
	}

	@media (min-width: 481px) {
		.page-cover {
			padding-top: 66.6666%;
		}
	}

	@media (min-width: 768px) {
		.page-cover {
			padding-top: 50%; /* 2:1 */
		}
	}

	@media (max-width: 900px) {
		.more-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.more-grid {
			grid-template-columns: 1fr;
		}

		.page-title {
			font-size: 1.5rem;
		}
	}
</style>
