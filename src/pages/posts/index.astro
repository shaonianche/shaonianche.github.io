---
/**
 * Blog list -- port of theme/layouts/index.vue.
 * Header with random haiku, 3-col card grid, cursor pagination.
 */
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { randomHaiku } from "../../utils/haiku";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const haiku = randomHaiku();
---

<Base title="Blog" description="All blog posts">
	<div class="tach-blog">
		<section class="tach-layout-header">
			<div class="header-inner">
				<h1>Blog</h1>
				<p class="haiku">{haiku}</p>
			</div>
		</section>
		<section class="tach-blog-items">
			{
				posts.length === 0 ? (
					<p class="empty">No posts yet.</p>
				) : (
					<div class="post-list">
						{posts.map((post) => (
							<div class="post-card-wrap">
								<PostCard
									title={post.data.title ?? "Untitled"}
									excerpt={post.data.excerpt}
									featuredImage={post.data.featured_image}
									href={`/posts/${post.id}`}
									date={post.data.publishedAt ?? undefined}
									edit={post.edit}
								/>
							</div>
						))}
					</div>
				)
			}
			<nav class="pagination" aria-label="Pagination">
				<div class="prev-wrap">
					{cursor && <a href="/posts">← First page</a>}
				</div>
				<div class="next-wrap">
					{
						nextCursor && (
							<a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>
								Next page →
							</a>
						)
					}
				</div>
			</nav>
		</section>
	</div>
</Base>

<style>
	.tach-layout-header {
		padding-top: 1rem;
	}

	.header-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--gap-m);
	}

	.tach-layout-header h1 {
		font-size: 2rem;
		margin-bottom: var(--gap-m);
	}

	.tach-layout-header .haiku {
		font-size: 80%;
		font-weight: 400;
		color: var(--color-text-secondary);
	}

	.tach-blog-items {
		padding: 1rem 0;
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	.post-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--gap-m);
		padding: 0 var(--gap-m);
	}

	.empty {
		padding: 0 var(--gap-m);
		color: var(--color-text-secondary);
	}

	.pagination {
		display: flex;
		justify-content: space-between;
		padding: var(--gap-l) var(--gap-m);
	}

	.pagination a {
		display: inline-flex;
		align-items: center;
		color: var(--color-text-primary);
		text-decoration: none;
	}

	.pagination a:hover {
		color: var(--color-link);
	}

	@media (max-width: 900px) {
		.post-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.post-list {
			grid-template-columns: 1fr;
		}
	}
</style>
