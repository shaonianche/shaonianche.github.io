---
/**
 * SiteFooter -- port of theme/components/Footer.vue.
 * "© {since}-{year} {author}. Made with ❤︎ in Beijing" + social links.
 * Keeps the theme switcher and footer widget area from the template.
 */
import { WidgetArea } from "emdash/ui";

interface SocialLink {
	name: string;
	path: string;
}

const SOCIAL_LINKS: SocialLink[] = [
	{ name: "Instagram", path: "https://www.instagram.com/alone_cmj/?hl=en" },
	{ name: "GitHub", path: "https://github.com/shaonianche" },
	{ name: "Twitter", path: "https://twitter.com/Bonjour_Ar" },
	{ name: "Steam", path: "https://steamcommunity.com/id/duanf/" },
];

const SINCE = "2016";
const AUTHOR = "DuanFei";
const nowYear = new Date().getFullYear();
const yearRange = `${SINCE}-${nowYear}`;
---

<footer class="tach-footer">
	<div class="tach-footer-inner">
		<div class="footer-main">
			<section class="footer-copyright">
				<!-- &#xfe0e; prevents rendering ❤︎ as an emoji on iOS/Android -->
				<div>
					© {yearRange} {AUTHOR}. Made with{" "}
					<span class="heart">❤︎&#xfe0e;</span> in Beijing
				</div>
			</section>
			<section class="footer-social">
				<ul class="social-network">
					{
						SOCIAL_LINKS.map((item) => (
							<li>
								<a href={item.path} target="_blank" rel="noopener">
									{item.name}
								</a>
							</li>
						))
					}
					<li>
						<a href="/rss.xml">RSS</a>
					</li>
				</ul>
			</section>
		</div>
		<div class="footer-widgets">
			<WidgetArea name="footer" />
		</div>
		<div class="footer-bottom">
			<p class="footer-powered">
				Powered by <a href="https://emdashcms.com">EmDash</a>
			</p>
			<div class="theme-switcher" role="group" aria-label="Color theme">
				<button type="button" class="theme-btn" data-theme="light" aria-label="Light mode">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
				</button>
				<button type="button" class="theme-btn" data-theme="dark" aria-label="Dark mode">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
				</button>
				<button type="button" class="theme-btn" data-theme="system" aria-label="System theme">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
				</button>
			</div>
		</div>
	</div>
</footer>

<script>
	const themeBtns = document.querySelectorAll<HTMLButtonElement>(".theme-btn");
	const root = document.documentElement;

	function setCookie(name: string, value: string, maxAge = 31536000) {
		const secure = location.protocol === "https:" ? "; Secure" : "";
		document.cookie =
			value === ""
				? `${name}=; path=/; max-age=0; SameSite=Lax${secure}`
				: `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
	}

	function updateActiveBtn(theme: string) {
		themeBtns.forEach((btn) => {
			const active = btn.dataset.theme === theme;
			btn.classList.toggle("active", active);
			btn.setAttribute("aria-pressed", String(active));
		});
	}

	function setTheme(theme: string) {
		if (theme === "system") {
			setCookie("theme", "");
			root.classList.remove("light", "dark");
		} else {
			setCookie("theme", theme);
			root.classList.remove("light", "dark");
			root.classList.add(theme);
		}
		updateActiveBtn(theme);
	}

	function getStoredTheme(): string {
		const row = document.cookie
			.split("; ")
			.find((item) => item.startsWith("theme="));
		return row?.slice(6) || "system";
	}

	setTheme(getStoredTheme());
	themeBtns.forEach((btn) => {
		btn.addEventListener("click", () => setTheme(btn.dataset.theme || "system"));
	});
</script>

<style>
	.tach-footer {
		padding: 0 0 4rem 0;
		background: var(--color-background);
		color: var(--color-text-primary);
		font-size: 0.75rem;
	}

	.tach-footer-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--gap-m);
	}

	.footer-main {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--gap-m);
		padding: var(--gap-l) 0;
	}

	.heart {
		color: #b30e2e;
	}

	.social-network {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--gap-m);
	}

	.social-network a {
		color: var(--color-text-primary);
		text-decoration: none;
	}

	.social-network a:hover {
		color: var(--color-link);
		text-decoration: underline;
	}

	.footer-widgets :global(.widget-area) {
		display: block;
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--gap-m);
		padding-top: var(--gap-m);
		border-top: 1px solid var(--color-border-subtle);
	}

	.footer-powered {
		margin: 0;
		color: var(--color-muted);
	}

	.footer-powered a {
		color: var(--color-text-secondary);
	}

	.theme-switcher {
		display: flex;
		gap: 0.25rem;
		padding: 0.25rem;
		background: var(--color-surface);
		border-radius: 0.5rem;
	}

	.theme-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 28px;
		background: transparent;
		border: none;
		color: var(--color-muted);
		border-radius: 0.375rem;
		cursor: pointer;
	}

	.theme-btn:hover {
		color: var(--color-text-secondary);
	}

	.theme-btn.active {
		background: var(--color-bg);
		color: var(--color-text);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
	}

	@media (max-width: 480px) {
		.tach-footer {
			text-align: center;
		}

		.footer-main {
			flex-direction: column;
		}

		.social-network {
			justify-content: center;
		}

		.footer-bottom {
			flex-direction: column;
		}
	}
</style>
