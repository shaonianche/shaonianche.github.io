---
/**
 * PostCard -- port of the post card from theme/layouts/index.vue.
 * 3:2 cover, date, title, excerpt with fade-out clamp.
 */
import { resolveImageUrl, resolveImageAlt } from "../utils/media";
import { formatCardDate } from "../utils/format-date";

interface Props {
	title: string;
	excerpt?: string | null;
	featuredImage?: unknown;
	href: string;
	date?: Date | null;
	edit?: Record<string, unknown>;
}

const { title, excerpt, featuredImage, href, date, edit } = Astro.props;
const img = resolveImageUrl(featuredImage);
---

<article class="post-card">
	{
		img && (
			<div class="post-card-image">
				<a class="link" href={href} aria-label={title}>
					<img
						src={img}
						alt={resolveImageAlt(featuredImage) || title}
						loading="lazy"
					/>
					<span class="overlay" />
				</a>
			</div>
		)
	}
	<div class="post-card-info">
		{
			date && (
				<div class="post-meta">
					<time datetime={date.toISOString()}>{formatCardDate(date)}</time>
				</div>
			)
		}
		<h4 class="post-title" {...(edit as any)?.title}>
			<a href={href} title={title}>
				{title}
			</a>
		</h4>
		{
			excerpt && (
				<div class="post-excerpt" {...(edit as any)?.excerpt}>
					<small>{excerpt}</small>
				</div>
			)
		}
	</div>
</article>

<style>
	.post-card {
		width: 100%;
		height: 100%;
		list-style: none;
	}

	.post-card-image {
		position: relative;
		background-color: var(--color-surface);
		overflow: hidden;
		aspect-ratio: 3 / 2;
	}

	.post-card-image a.link {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.post-card-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post-card-image .overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.post-card-info {
		padding: 0.4445rem;
		word-break: break-all;
		text-align: justify;
	}

	.post-meta {
		color: var(--color-text-secondary);
		display: block;
		font-size: 0.75rem;
		font-style: italic;
	}

	.post-title {
		padding: 0.4445rem 0;
		display: block;
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.2;
	}

	.post-title a {
		color: var(--color-text-primary);
		text-decoration: none;
	}

	.post-title a:hover {
		color: var(--color-link);
		text-decoration: none;
	}

	.post-excerpt {
		position: relative;
		max-height: 4rem;
		overflow: hidden;
		color: var(--color-text-secondary);
		line-height: 1.3rem;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}

	/* fade out ellipsis */
	.post-excerpt::after {
		content: "";
		text-align: right;
		position: absolute;
		bottom: 0;
		right: 0;
		width: 40%;
		height: 1.3em;
		background: linear-gradient(
			to right,
			var(--color-background-transparent),
			var(--color-background) 80%
		);
	}
</style>
