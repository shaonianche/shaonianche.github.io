---
/**
 * SiteHeader -- port of theme/components/Header.vue.
 * Simple navbar: site title left, nav links right, burger on mobile.
 * Keeps EmDash's LiveSearch and the signed-in Admin link.
 */
import LiveSearch from "emdash/ui/search";

interface MenuItem {
	url: string;
	label: string;
	target?: string | null;
}

interface Props {
	siteTitle: string;
	menuItems?: MenuItem[];
	isLoggedIn?: boolean;
}

const { siteTitle, menuItems = [], isLoggedIn = false } = Astro.props;
---

<header class="tach-header">
	<nav class="navbar" aria-label="主导航">
		<div class="navbar-brand">
			<a href="/" class="navbar-item site-title">{siteTitle}</a>
			<button
				type="button"
				class="navbar-burger"
				aria-label="切换导航菜单"
				aria-expanded="false"
				data-burger
			>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
			</button>
		</div>
		<div class="navbar-menu" data-menu>
			<div class="navbar-search">
				<LiveSearch
					placeholder="Search…"
					class="site-search"
					inputClass="site-search-input"
					resultsClass="site-search-results"
					resultClass="site-search-result"
					collections={["posts", "pages"]}
				/>
			</div>
			<div class="navbar-end">
				{
					menuItems.map((item) => (
						<a
							href={item.url}
							target={item.target ?? undefined}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							class="navbar-item"
						>
							{item.label}
						</a>
					))
				}
				{
					isLoggedIn && (
						<a href="/_emdash/admin" class="navbar-item nav-admin">
							Admin
						</a>
					)
				}
			</div>
		</div>
	</nav>
</header>

<script>
	const burger = document.querySelector("[data-burger]");
	const menu = document.querySelector("[data-menu]");
	burger?.addEventListener("click", () => {
		const open = menu?.classList.toggle("is-active");
		burger.classList.toggle("is-active", !!open);
		burger.setAttribute("aria-expanded", String(!!open));
	});
</script>

<style>
	.tach-header {
		position: sticky;
		top: 0;
		z-index: 100;
	}

	.navbar {
		background-color: var(--color-background);
		color: var(--color-text-primary);
		box-shadow: 0px 5px 60px 0px rgba(100, 100, 100, 0.1);
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--gap-m);
		min-height: 3.25rem;
	}

	.navbar-brand {
		display: flex;
		align-items: center;
	}

	.site-title {
		font-size: var(--font-size-lg);
		font-weight: 600;
		color: var(--color-text-primary);
		text-decoration: none;
		padding: 0.75rem 0;
		white-space: nowrap;
	}

	.site-title:hover {
		color: var(--color-link);
		text-decoration: none;
	}

	.navbar-menu {
		display: flex;
		align-items: center;
		gap: var(--gap-l);
	}

	.navbar-end {
		display: flex;
		align-items: center;
	}

	.navbar-item {
		color: var(--color-text-primary);
		text-decoration: none;
		padding: 0.75rem;
		font-size: var(--font-size-base);
		white-space: nowrap;
	}

	.navbar-item:hover,
	.navbar-item:focus {
		background-color: var(--color-accent-0);
		color: var(--color-link);
		text-decoration: none;
	}

	.navbar-search {
		display: flex;
		align-items: center;
	}

	.navbar-burger {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.75rem;
		color: var(--color-text-primary);
	}

	.navbar-burger span {
		display: block;
		width: 20px;
		height: 2px;
		background: currentColor;
		margin: 4px 0;
		transition: transform 0.2s ease;
	}

	.navbar-burger.is-active span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.navbar-burger.is-active span:nth-child(2) {
		opacity: 0;
	}
	.navbar-burger.is-active span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	/* Search field inherits the template's search styling hooks */
	.navbar-search :global(.site-search) {
		position: relative;
	}

	.navbar-search :global(.site-search-input) {
		width: 11rem;
		padding: var(--gap-s) var(--gap-m);
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-bg);
		color: var(--color-text);
	}

	.navbar-search :global(.site-search-input)::placeholder {
		color: var(--color-muted);
	}

	.navbar-search :global(.site-search-input):focus {
		outline: none;
	}

	.navbar-search :global(.site-search-input):focus-visible {
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.navbar-search :global(.site-search-results) {
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 0;
		width: 20rem;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
		max-height: 400px;
		overflow-y: auto;
		z-index: 1000;
	}

	@media (max-width: 767px) {
		.navbar {
			flex-wrap: wrap;
			padding: 0 var(--gap-m);
		}

		.navbar-brand {
			width: 100%;
			justify-content: space-between;
		}

		.navbar-burger {
			display: block;
		}

		.navbar-menu {
			display: none;
			width: 100%;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: var(--gap-m);
			background-color: var(--color-background);
		}

		.navbar-menu.is-active {
			display: flex;
		}

		.navbar-end {
			flex-direction: column;
			align-items: stretch;
		}

		.navbar-item {
			padding: 0.6rem 0;
		}

		.navbar-search {
			margin-bottom: var(--gap-m);
		}

		.navbar-search :global(.site-search),
		.navbar-search :global(.site-search-input) {
			width: 100%;
		}
	}
</style>
